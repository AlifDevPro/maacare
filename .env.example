NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Facebook app id for Open Graph (fb:app_id)
NEXT_PUBLIC_FB_APP_ID=

GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional: Groq Llama 4 Scout vision for report image OCR on Vercel (default: meta-llama/llama-4-scout-17b-16e-instruct)
GROQ_VISION_MODEL=
# Optional: Groq text model for report simplification (default: llama-3.3-70b-versatile)
GROQ_REPORT_MODEL=
# Optional: Groq model for query translation / reply localize (default: llama-3.1-8b-instant)
GROQ_TRANSLATE_MODEL=

# Multilingual pipeline: CLD3 detect → Groq translate → Groq answer (set 0 to use legacy LLM prep)
MULTILINGUAL_PIPELINE_ENABLED=1
# Optional fastText model path for long-running Node hosts (Vercel: leave unset)
FASTTEXT_MODEL_PATH=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
CRON_SECRET=
# Vercel Hobby: vercel.json cron is once/day. Pro can use "* * * * *" for per-minute queue drain.

# Copy to .env on the server and fill in values.
# NEXT_PUBLIC_* must match the values used when the image was built.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- AI (at least one provider recommended) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=
GROQ_REPORT_MODEL=
GROQ_TRANSLATE_MODEL=
MULTILINGUAL_PIPELINE_ENABLED=1

# --- Firebase push (optional) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Prefer JSON or base64 in Docker (no file mount required):
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# --- Ops ---
CRON_SECRET=
MCP_ENABLED=0
SUBSCRIPTION_MOCK_PAYMENTS=1
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=
